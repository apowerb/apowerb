# .env example
# Copy this file to .env and fill in the values

# ── Database ──────────────────────────────────────
WORKING_MODE=dev
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SCHEMA=your_database_schema

# ── JWT / Encryption ─────────────────────────────
# Used for both Fernet encryption at rest AND JWT signing. Must be a
# urlsafe-base64 32-byte key (Fernet.generate_key()).
ENCRYPT_KEY=your_encrypt_key
ENCRYPT_PASS=your_encryption_password
TEST_TOKEN=your_test_token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS ──────────────────────────────────────────
FRONTEND_URLS=["http://localhost:3000"]

# ── OAuth — GitHub ────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# ── OAuth — Google ────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ── OAuth — Microsoft ─────────────────────────────
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common

# ── OAuth — LinkedIn ────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ── Stripe (Billing) ─────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── S3 (optional) ────────────────────────────────
# S3_REGION=your_s3_region
# S3_ACCESS=your_s3_access_key
# S3_SECRET=your_s3_secret_key
# S3_ENDPOINT=your_s3_endpoint
# S3_BUCKET_NAME=your_s3_bucket_name

# ── Scheduler / Mage (optional) ──────────────────
# BASE_URL=http://localhost:6789
# API_KEY=your_mage_api_key
# OAUTH_TOKEN=your_mage_oauth_token
# PROJECT_NAME=default_repo

# ── Google Integration OAuth ────────────────────
# OAuth app for Gmail/Google Workspace integrations (separate from login OAuth)
GOOGLE_INTEGRATION_CLIENT_ID=your_google_integration_client_id
GOOGLE_INTEGRATION_CLIENT_SECRET=your_google_integration_client_secret
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# ── Gmail Pub/Sub Webhooks ─────────────────────
# Google Cloud project ID hosting the Pub/Sub topic
GMAIL_PUBSUB_PROJECT_ID=your_gcp_project_id
# Pub/Sub topic name (just the name, not the full path)
GMAIL_PUBSUB_TOPIC=gmail-notifications
# Expected `aud` claim on the OIDC JWT signed by Google when pushing
# Pub/Sub notifications to POST /api/webhooks/gmail/notifications.
# Must match the audience configured on the Pub/Sub subscription
# (typically the full public webhook URL).
# MANDATORY in production — boot refuses without it.
GOOGLE_WEBHOOK_AUDIENCE=https://your-public-host/api/webhooks/gmail/notifications
# DEV-ONLY escape hatch: set to true to skip OIDC signature verification
# on the Gmail webhook (local development without a Google Cloud setup).
# MUST remain false in production (boot refuses otherwise).
WEBHOOK_DEV_SKIP_SIG=false

# ── MCP Toolbox for Databases ────────────────────
# URL of the MCP Toolbox server (Go binary)
# MCP_TOOLBOX_URL=http://localhost:5000
# Optional: restrict to a specific toolset defined in tools.yaml
# MCP_TOOLBOX_TOOLSET=

# ── RAG Webhook / SSE ───────────────────────────
# Public URL of this th2agent instance (used as callback_url for th2llm webhooks)
PUBLIC_BASE_URL=http://localhost:8000
# HMAC-SHA256 secret for verifying webhook signatures (must match th2llm WEBHOOK_SECRET)
RAG_WEBHOOK_SECRET=th2-webhook-default-secret
# RAG API base URL (th2llm)
RAG_BASE_URL=https://rag-dev.thaink2.fr

# ── Modèle thaink2 par défaut ───────────────────────────────────
# Credentials mutualisées servant les agents dont agent_model vaut
# `thaink2/default` : l'utilisateur ne saisit ni clé ni modèle, et ne peut
# pas les lire (elles ne sont jamais persistées ni renvoyées par l'API).
# Le provider n'apparaît dans GET /models que si MODEL **et** KEY sont
# renseignés — sinon l'option n'existe simplement pas.
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
DEFAULT_LLM_API_KEY=your_shared_gemini_api_key
# Optionnel — endpoint OpenAI-compat (ex. OVH) si le modèle n'est pas servi
# par l'API publique du provider.
DEFAULT_LLM_API_BASE=
# Plafond mensuel de tokens sur le modèle mutualisé, PAR UTILISATEUR.
# Ne compte que la consommation payée par thaink2 : une clé API perso
# n'est jamais plafonnée. 0 = illimité (kill-switch sans redéploiement).
DEFAULT_LLM_MONTHLY_TOKEN_QUOTA=1000000
# Override par plan, en JSON — ex. {"free": 1000000, "pro": 50000000}
DEFAULT_LLM_PLAN_QUOTAS=
