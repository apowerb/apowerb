  }
 ],
 "sources": [
  {
   "dataset_id": "11111111-2222-3333-4444-555555555555",
   "fields": [
    {
     "label": "Date de commande",
     "name": "date",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Commande",
     "name": "commande_id",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Montant",
     "name": "montant",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Client",
     "name": "customer_id",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Coût des produits",
     "name": "product_cost",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Canal",
     "name": "channel",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Dépense publicitaire",
     "name": "ad_spend",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Nouveau client",
     "name": "client_nouveau",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Semaine",
     "name": "periode_semaine",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    }
   ],
   "kind": "dataset",
   "label": "Commandes",
   "measures": [
    {
     "description": "Somme des montants des commandes (annulées et remboursées exclues).",
     "expr": "SUM(\"montant\")",
     "format": "compact",
     "label": "Chiffre d'affaires",
     "name": "ca",
     "unit": "€"
    },
    {
     "description": "Nombre de commandes distinctes.",
     "expr": "COUNT(DISTINCT \"commande_id\")",
     "format": "integer",
     "label": "Commandes",
     "name": "commandes",
     "unit": "commandes"
    },
    {
     "description": "Chiffre d'affaires ÷ nombre de commandes.",
     "expr": "SUM(\"montant\") / NULLIF(COUNT(DISTINCT \"commande_id\"), 0)",
     "format": "decimal1",
     "label": "Panier moyen",
     "name": "panier_moyen",
     "unit": "€"
    },
    {
     "expr": "SUM(\"ad_spend\")",
     "format": "compact",
     "label": "Dépense publicitaire",
     "name": "depense_pub",
     "unit": "€"
    },
    {
     "description": "Return on ad spend : chiffre d'affaires ÷ dépense publicitaire.",
     "expr": "SUM(\"montant\") / NULLIF(SUM(\"ad_spend\"), 0)",
     "format": "decimal1",
     "label": "ROAS",
     "name": "roas",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 2.0,
      "warn": 2.0
     }
    },
    {
     "description": "Chiffre d'affaires - coût des produits - dépense publicitaire.",
     "expr": "SUM(\"montant\") - SUM(\"product_cost\") - COALESCE(SUM(\"ad_spend\"), 0)",
     "format": "compact",
     "label": "Marge de contribution",
     "name": "marge_contribution",
     "unit": "€"
    },
    {
     "description": "Marge de contribution ÷ chiffre d'affaires.",
     "expr": "(SUM(\"montant\") - SUM(\"product_cost\") - COALESCE(SUM(\"ad_spend\"), 0)) / NULLIF(SUM(\"montant\"), 0)",
     "format": "percent",
     "label": "Taux de marge de contribution",
     "name": "taux_marge"
    },
    {
     "expr": "COUNT(DISTINCT CASE WHEN client_nouveau = 1 THEN \"customer_id\" END)",
     "format": "integer",
     "label": "Nouveaux clients",
     "name": "nouveaux_clients",
     "unit": "clients"
    },
    {
     "description": "Dépense publicitaire ÷ nouveaux clients.",
     "expr": "SUM(\"ad_spend\") / NULLIF(COUNT(DISTINCT CASE WHEN client_nouveau = 1 THEN \"customer_id\" END), 0)",
     "format": "decimal1",
     "label": "Coût d'acquisition client",
     "name": "cac",
     "unit": "€"
    },
    {
     "description": "Clients ayant passé au moins une commande sur la période.",
     "expr": "(SELECT COUNT(DISTINCT \"customer_id\") FROM frame WHERE \"customer_id\" IS NOT NULL AND \"commande_id\" IS NOT NULL)",
     "format": "integer",
     "label": "Clients actifs",
     "name": "clients_actifs",
     "unit": "clients"
    },
    {
     "description": "Clients ayant passé au moins deux commandes sur la période ÷ clients actifs.",
     "expr": "(SELECT COUNT(*) FROM (SELECT \"customer_id\" FROM frame WHERE \"customer_id\" IS NOT NULL AND \"commande_id\" IS NOT NULL GROUP BY \"customer_id\" HAVING COUNT(DISTINCT \"commande_id\") >= 2)) / NULLIF((SELECT COUNT(DISTINCT \"customer_id\") FROM frame WHERE \"customer_id\" IS NOT NULL AND \"commande_id\" IS NOT NULL), 0)",
     "format": "percent",
     "label": "Clients récurrents",
     "name": "clients_recurrents"
    }
   ],
   "name": "commandes",
   "source_options": {},
   "transforms": [
    {
     "op": "filter",
     "where": "\"status\" IS NULL OR NOT (LOWER(TRIM(CAST(\"status\" AS VARCHAR))) LIKE 'annul%' OR LOWER(TRIM(CAST(\"status\" AS VARCHAR))) LIKE 'rembours%' OR LOWER(TRIM(CAST(\"status\" AS VARCHAR))) LIKE 'cancel%' OR LOWER(TRIM(CAST(\"status\" AS VARCHAR))) LIKE 'refund%')"
    },
    {
     "column": "periode_semaine",
     "expr": "date_trunc('week', CAST(\"date\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "client_nouveau",
     "expr": "CASE WHEN \"new_customer\" IS NULL THEN NULL WHEN LOWER(TRIM(CAST(\"new_customer\" AS VARCHAR))) IN ('1', '1.0', 'true', 'vrai', 'oui', 'yes', 'y', 'o') THEN 1 ELSE 0 END",
     "op": "derive"
    }
   ]
  }
 ]
}
