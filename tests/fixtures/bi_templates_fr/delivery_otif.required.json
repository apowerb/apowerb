    },
    {
     "format": "integer",
     "label": "Ligne livrée",
     "name": "ligne_livree",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Ligne livrée à l'heure",
     "name": "ligne_a_lheure",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Ligne livrée complète",
     "name": "ligne_complete",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Ligne OTIF",
     "name": "ligne_otif",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "decimal1",
     "label": "Retard (jours)",
     "name": "retard_jours",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Tranche de retard",
     "name": "tranche_retard",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "integer",
     "label": "Ligne en retard non livrée",
     "name": "ligne_en_retard_ouverte",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Ligne échue",
     "name": "ligne_echue",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Quantité due",
     "name": "qte_due",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Quantité servie",
     "name": "qte_servie",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Mois",
     "name": "periode_mois",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    }
   ],
   "kind": "dataset",
   "label": "Lignes de commande livrées",
   "measures": [
    {
     "expr": "COUNT(*)",
     "format": "integer",
     "label": "Lignes de commande",
     "name": "lignes",
     "unit": "lignes"
    },
    {
     "expr": "SUM(ligne_livree)",
     "format": "integer",
     "label": "Lignes livrées",
     "name": "lignes_livrees",
     "unit": "lignes"
    },
    {
     "description": "Lignes livrées à la date promise ou avant, sur les lignes livrées.",
     "expr": "AVG(ligne_a_lheure)",
     "format": "percent",
     "label": "Livré à l'heure",
     "name": "a_l_heure",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.95,
      "warn": 0.9
     }
    },
    {
     "description": "Lignes livrées avec au moins la quantité commandée.",
     "expr": "AVG(ligne_complete)",
     "format": "percent",
     "label": "Livré complet",
     "name": "complet",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.95,
      "warn": 0.9
     }
    },
    {
     "description": "On Time In Full : lignes livrées à l'heure et complètes, sur les lignes livrées.",
     "expr": "AVG(ligne_otif)",
     "format": "percent",
     "label": "OTIF",
     "name": "otif",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.95,
      "warn": 0.9
     }
    },
    {
     "description": "Jours de retard moyens des lignes livrées en retard.",
     "expr": "AVG(retard_jours)",
     "format": "decimal1",
     "label": "Retard moyen",
     "name": "retard_moyen",
     "unit": "jours"
    },
    {
     "description": "Lignes non livrées dont la date promise précède la dernière livraison connue.",
     "expr": "COALESCE(SUM(ligne_en_retard_ouverte), 0)",
     "format": "integer",
     "label": "En retard non livrées",
     "name": "retards_en_cours",
     "unit": "lignes"
    },
    {
     "description": "Quantité livrée (plafonnée à la commande) sur la quantité commandée des lignes échues.",
     "expr": "SUM(qte_servie) / NULLIF(SUM(qte_due), 0)",
     "format": "percent",
     "label": "Taux de service quantité",
     "name": "taux_service_qte"
    }
   ],
   "name": "livraisons",
   "source_options": {},
   "transforms": [
    {
     "column": "ligne_livree",
     "expr": "CASE WHEN \"date_livraison\" IS NULL THEN 0 ELSE 1 END",
     "op": "derive"
    },
    {
     "column": "ligne_a_lheure",
     "expr": "CASE WHEN \"date_livraison\" IS NULL OR \"date_promise\" IS NULL THEN NULL WHEN CAST(\"date_livraison\" AS DATE) <= CAST(\"date_promise\" AS DATE) THEN 1 ELSE 0 END",
     "op": "derive"
    },
    {
     "column": "ligne_complete",
     "expr": "CASE WHEN \"date_livraison\" IS NULL THEN NULL WHEN COALESCE(\"qte_livree\", 0) >= \"qte_commandee\" THEN 1 ELSE 0 END",
     "op": "derive"
    },
    {
     "column": "ligne_otif",
     "expr": "ligne_a_lheure * ligne_complete",
     "op": "derive"
    },
    {
     "column": "retard_jours",
     "expr": "CASE WHEN \"date_livraison\" IS NOT NULL AND \"date_promise\" IS NOT NULL AND CAST(\"date_livraison\" AS DATE) > CAST(\"date_promise\" AS DATE) THEN date_diff('day', CAST(\"date_promise\" AS DATE), CAST(\"date_livraison\" AS DATE)) END",
     "op": "derive"
    },
    {
     "column": "tranche_retard",
     "expr": "CASE WHEN \"date_livraison\" IS NULL OR \"date_promise\" IS NULL THEN NULL WHEN retard_jours IS NULL THEN '0 j' WHEN retard_jours <= 2 THEN '1-2 j' WHEN retard_jours <= 5 THEN '3-5 j' WHEN retard_jours <= 10 THEN '6-10 j' ELSE '> 10 j' END",
     "op": "derive"
    },
    {
     "column": "ligne_en_retard_ouverte",
     "expr": "CASE WHEN \"date_livraison\" IS NULL AND \"date_promise\" IS NOT NULL AND CAST(\"date_promise\" AS DATE) < CAST(MAX(\"date_livraison\") OVER () AS DATE) THEN 1 ELSE 0 END",
     "op": "derive"
    },
    {
     "column": "ligne_echue",
     "expr": "CASE WHEN ligne_livree = 1 OR ligne_en_retard_ouverte = 1 THEN 1 ELSE 0 END",
     "op": "derive"
    },
    {
     "column": "qte_due",
     "expr": "CASE WHEN ligne_echue = 1 THEN \"qte_commandee\" END",
     "op": "derive"
    },
    {
     "column": "qte_servie",
     "expr": "CASE WHEN ligne_echue = 1 THEN LEAST(COALESCE(\"qte_livree\", 0), \"qte_commandee\") END",
     "op": "derive"
    },
    {
     "column": "periode_mois",
     "expr": "date_trunc('month', CAST(\"date_promise\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    }
   ]
  }
 ]
}
