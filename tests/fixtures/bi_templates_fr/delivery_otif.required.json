 "sources": [
  {
   "dataset_id": "11111111-2222-3333-4444-555555555555",
   "fields": [
    {
     "label": "Date de commande",
     "name": "date_commande",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Date promise",
     "name": "date_promise",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Date de livraison",
     "name": "date_livraison",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "format": "compact",
     "label": "Quantité commandée",
     "name": "qte_commandee",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Quantité livrée",
     "name": "qte_livree",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Client",
     "name": "client",
