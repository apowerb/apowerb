    "total_row": false,
    "type": "note"
   }
  },
  {
   "position": {
    "col": 4,
    "height": 4,
    "row": 32,
    "width": 4
   },
   "visual": {
    "badges": [
     "forecast"
    ],
    "click_filters": {},
    "columns": [],
    "ignore_filters": [],
    "reference_lines": [],
    "series": [],
    "steps": [],
    "text": "La prévision est volontairement simple : au début de l'historique, moyenne des 4 semaines précédentes ; ensuite, ventes de la même semaine l'an dernier, corrigées de la tendance récente (bornée entre 0,8 et 1,25).",
    "title": "Méthode de prévision",
    "total_row": false,
    "type": "note"
   }
  },
  {
   "position": {
    "col": 8,
    "height": 4,
    "row": 32,
    "width": 4
   },
   "visual": {
    "badges": [
