    ],
    "click_filters": {},
    "columns": [],
    "ignore_filters": [],
    "reference_lines": [],
    "series": [],
    "steps": [],
    "text": "Stock de sécurité : 0,5 × la prévision de la semaine. Commande : 1,4 × la prévision de la semaine suivante + stock de sécurité - stock en fin de semaine. Délai de livraison : 1 semaine. Les commandes sont arrondies au lot de 100 unités.",
    "title": "Règles de réapprovisionnement simulées",
    "total_row": false,
    "type": "note"
   }
  },
  {
