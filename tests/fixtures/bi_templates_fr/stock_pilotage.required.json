   ],
   "kind": "dataset",
   "label": "Stocks et prévisions",
   "measures": [
    {
     "description": "Stock de la dernière semaine de la période.",
     "expr": "SUM(stock_fin) FILTER (WHERE semaine = (SELECT MAX(semaine) FROM frame))",
     "format": "compact",
     "label": "Stock fin de semaine",
     "name": "stock_fin_semaine",
     "unit": "unités"
    },
    {
     "expr": "SUM(stock_fin) FILTER (WHERE semaine = (SELECT MAX(semaine) FROM frame WHERE semaine < (SELECT MAX(semaine) FROM frame)))",
     "format": "compact",
     "label": "Stock semaine précédente",
     "name": "stock_semaine_precedente",
     "unit": "unités"
    },
    {
     "description": "Stock de la dernière semaine par rapport à la semaine précédente.",
     "expr": "SUM(stock_fin) FILTER (WHERE semaine = (SELECT MAX(semaine) FROM frame)) / NULLIF(SUM(stock_fin) FILTER (WHERE semaine = (SELECT MAX(semaine) FROM frame WHERE semaine < (SELECT MAX(semaine) FROM frame))), 0) - 1",
     "format": "percent",
     "label": "Variation du stock",
     "name": "variation_stock"
    },
    {
     "description": "Stock fin de semaine ÷ prévision de cette semaine.",
     "expr": "SUM(stock_fin) FILTER (WHERE semaine = (SELECT MAX(semaine) FROM frame)) / NULLIF(SUM(prevision) FILTER (WHERE semaine = (SELECT MAX(semaine) FROM frame)), 0)",
     "format": "weeks",
     "label": "Couverture",
     "name": "couverture",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 1.0,
      "warn": 0.5
     }
    },
    {
     "description": "Part de la demande servie sur la période.",
     "expr": "1 - SUM(demande_non_servie) / NULLIF(SUM(ventes), 0)",
     "format": "percent",
     "label": "Taux de service",
     "name": "taux_service",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.99,
      "warn": 0.97
     }
    },
    {
     "description": "1 moins l'erreur absolue totale rapportée aux ventes.",
     "expr": "1 - SUM(ABS(ventes - prevision)) / NULLIF(SUM(ventes), 0)",
     "format": "percent",
     "label": "Fiabilité de la prévision",
     "name": "fiabilite",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.9,
      "warn": 0.8
     }
    },
    {
     "description": "Positif : la prévision est inférieure aux ventes.",
     "expr": "(SUM(ventes) - SUM(prevision)) / NULLIF(SUM(prevision), 0)",
     "format": "percent",
     "label": "Biais de prévision",
     "name": "biais"
    },
    {
     "description": "Semaines où le stock total est inférieur au stock de sécurité total.",
     "expr": "COUNT(DISTINCT semaine) FILTER (WHERE semaine IN (SELECT semaine FROM frame GROUP BY semaine HAVING SUM(stock_fin) < SUM(stock_securite)))",
     "format": "integer",
     "label": "Semaines sous le stock de sécurité",
     "name": "semaines_sous_secu",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.0,
      "warn": 2.0
     },
     "unit": "semaines"
    },
    {
     "description": "Semaines où le stock de la famille est inférieur à son stock de sécurité.",
     "expr": "COUNT(DISTINCT semaine) FILTER (WHERE stock_fin < stock_securite)",
     "format": "integer",
     "label": "Semaines sous sécu",
     "name": "semaines_sous_secu_famille",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.0,
      "warn": 2.0
     },
     "unit": "semaines"
    },
    {
     "expr": "SUM(appro)",
     "format": "compact",
     "label": "Approvisionnements reçus",
     "name": "appro_recus",
     "unit": "unités"
    },
    {
     "expr": "SUM(ventes)",
     "format": "compact",
     "label": "Ventes",
     "name": "ventes_totales",
     "unit": "unités"
    },
    {
     "expr": "SUM(stock_debut) FILTER (WHERE semaine = (SELECT MIN(semaine) FROM frame))",
     "format": "compact",
     "label": "Stock début de période",
