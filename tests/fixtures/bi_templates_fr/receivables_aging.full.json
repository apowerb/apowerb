 "sources": [
  {
   "dataset_id": "11111111-2222-3333-4444-555555555555",
   "fields": [
    {
     "label": "Client",
     "name": "client",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "label": "Date de facture",
     "name": "date_facture",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Date d'échéance",
     "name": "date_echeance",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "format": "compact",
     "label": "Montant",
     "name": "montant",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Facture",
     "name": "invoice",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Reste dû",
     "name": "open_amount",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Montant réglé",
     "name": "paid_amount",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Date de paiement",
     "name": "payment_date",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "format": "compact",
     "label": "Reste dû",
     "name": "reste_du",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Jours de retard",
     "name": "jours_retard",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Reste dû échu",
     "name": "reste_echu",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Tranche d'ancienneté",
     "name": "tranche_anciennete",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Facturé sur 90 jours",
     "name": "ca_90j",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Mois",
     "name": "periode_mois",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    },
    {
     "format": "decimal1",
     "label": "Délai de règlement (jours)",
     "name": "delai_reglement_jours",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    }
   ],
   "kind": "dataset",
   "label": "Factures clients",
   "measures": [
    {
     "expr": "COUNT(*)",
     "format": "integer",
     "label": "Factures",
     "name": "factures",
     "unit": "factures"
    },
    {
     "expr": "SUM(\"montant\")",
     "format": "compact",
     "label": "Facturation",
     "name": "ca_facture"
    },
    {
     "description": "Reste dû sur l'ensemble des factures, échues ou non.",
     "expr": "COALESCE(SUM(reste_du), 0)",
     "format": "compact",
     "label": "Encours total",
     "name": "encours"
    },
    {
     "description": "Reste dû des factures dont l'échéance précède la dernière date de facture du fichier.",
     "expr": "COALESCE(SUM(reste_echu), 0)",
     "format": "compact",
     "label": "Encours échu",
     "name": "encours_echu"
    },
    {
     "description": "Encours échu sur encours total.",
     "expr": "COALESCE(SUM(reste_echu), 0) / NULLIF(SUM(reste_du), 0)",
     "format": "percent",
     "label": "% échu",
     "name": "pct_echu",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.1,
      "warn": 0.25
     }
    },
    {
     "description": "Encours divisé par la facturation des 90 derniers jours (jusqu'à la dernière date de facture du fichier), multiplié par 90.",
     "expr": "SUM(reste_du) / NULLIF(SUM(ca_90j), 0) * 90",
     "format": "decimal1",
     "label": "DSO",
     "name": "dso",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 45.0,
      "warn": 60.0
     },
     "unit": "jours"
    },
    {
     "description": "Jours de retard moyens des factures échues non soldées.",
     "expr": "AVG(jours_retard)",
     "format": "decimal1",
     "label": "Retard moyen",
     "name": "retard_moyen",
     "unit": "jours"
    },
    {
     "expr": "MAX(jours_retard)",
     "format": "integer",
     "label": "Retard maximal",
     "name": "retard_max",
     "unit": "jours"
    },
    {
     "description": "Jours entre la date de facture et la date de paiement, factures payées.",
     "expr": "AVG(delai_reglement_jours)",
     "format": "decimal1",
     "label": "Délai de règlement moyen",
     "name": "delai_reglement",
     "unit": "jours"
    }
   ],
   "name": "creances",
   "source_options": {},
   "transforms": [
    {
     "column": "reste_du",
     "expr": "COALESCE(COALESCE(\"open_amount\", 0), 0)",
     "op": "derive"
    },
    {
     "column": "jours_retard",
     "expr": "CASE WHEN reste_du > 0 AND \"date_echeance\" IS NOT NULL AND CAST(\"date_echeance\" AS DATE) < CAST(MAX(\"date_facture\") OVER () AS DATE) THEN date_diff('day', CAST(\"date_echeance\" AS DATE), CAST(MAX(\"date_facture\") OVER () AS DATE)) END",
     "op": "derive"
    },
    {
     "column": "reste_echu",
     "expr": "CASE WHEN jours_retard IS NOT NULL THEN reste_du END",
     "op": "derive"
    },
    {
     "column": "tranche_anciennete",
     "expr": "CASE WHEN reste_du > 0 AND \"date_echeance\" IS NOT NULL THEN CASE WHEN jours_retard IS NULL THEN '1. Non échu' WHEN jours_retard <= 30 THEN '2. 0-30 j' WHEN jours_retard <= 60 THEN '3. 31-60 j' WHEN jours_retard <= 90 THEN '4. 61-90 j' ELSE '5. > 90 j' END END",
     "op": "derive"
    },
    {
     "column": "ca_90j",
     "expr": "CASE WHEN date_diff('day', CAST(\"date_facture\" AS DATE), CAST(MAX(\"date_facture\") OVER () AS DATE)) < 90 THEN \"montant\" END",
     "op": "derive"
    },
    {
     "column": "periode_mois",
     "expr": "date_trunc('month', CAST(\"date_facture\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "delai_reglement_jours",
     "expr": "CASE WHEN \"payment_date\" IS NOT NULL THEN date_diff('day', CAST(\"date_facture\" AS DATE), CAST(\"payment_date\" AS DATE)) END",
     "op": "derive"
    }
   ]
  }
 ]
}
