     "type": "string"
    },
    {
     "label": "Semaine",
     "name": "periode_semaine",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    },
    {
     "format": "decimal1",
     "label": "Délai de première réponse (h)",
     "name": "delai_reponse_h",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Réponse hors objectif",
     "name": "reponse_hors_delai",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Ticket ouvert",
     "name": "ticket_ouvert",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "decimal1",
     "label": "Délai de résolution (h)",
     "name": "delai_resolution_h",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Résolution hors objectif",
     "name": "resolution_hors_delai",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "SLA respecté",
     "name": "sla_respecte",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    }
   ],
   "kind": "dataset",
   "label": "Tickets de support",
   "measures": [
    {
     "expr": "COUNT(DISTINCT \"ticket_id\")",
     "format": "integer",
     "label": "Tickets reçus",
     "name": "tickets",
     "unit": "tickets"
    },
    {
     "description": "Tickets sans date de résolution.",
     "expr": "COALESCE(SUM(ticket_ouvert), 0)",
     "format": "integer",
     "label": "Backlog ouvert",
     "name": "backlog",
     "unit": "tickets"
    },
    {
     "description": "Heures entre l'ouverture et la résolution, tickets résolus.",
     "expr": "MEDIAN(delai_resolution_h)",
     "format": "decimal1",
     "label": "Délai médian de résolution",
     "name": "delai_resolution",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 48.0,
      "warn": 96.0
     },
     "unit": "h"
    },
    {
     "description": "Heures entre l'ouverture et la première réponse, tickets répondus.",
     "expr": "MEDIAN(delai_reponse_h)",
     "format": "decimal1",
     "label": "Délai médian de première réponse",
     "name": "delai_reponse",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 4.0,
      "warn": 8.0
     },
     "unit": "h"
    },
    {
     "description": "Tickets sans objectif dépassé (première réponse, résolution), ouverts dont l'objectif n'est pas encore échu compris.",
     "expr": "AVG(sla_respecte)",
     "format": "percent",
     "label": "SLA respecté",
     "name": "sla",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.95,
      "warn": 0.9
     }
    }
   ],
   "name": "tickets",
   "source_options": {},
   "transforms": [
    {
     "column": "periode_semaine",
     "expr": "date_trunc('week', CAST(\"date_ouverture\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "delai_reponse_h",
     "expr": "CASE WHEN \"first_response_at\" IS NOT NULL THEN date_diff('second', CAST(\"date_ouverture\" AS TIMESTAMP), CAST(\"first_response_at\" AS TIMESTAMP)) / 3600.0 END",
     "op": "derive"
    },
    {
     "column": "reponse_hors_delai",
     "expr": "CASE WHEN \"first_response_at\" IS NOT NULL THEN CASE WHEN date_diff('second', CAST(\"date_ouverture\" AS TIMESTAMP), CAST(\"first_response_at\" AS TIMESTAMP)) > 14400 THEN 1 ELSE 0 END WHEN date_diff('second', CAST(\"date_ouverture\" AS TIMESTAMP), GREATEST(MAX(CAST(\"date_ouverture\" AS TIMESTAMP)) OVER (), MAX(CAST(\"first_response_at\" AS TIMESTAMP)) OVER (), MAX(CAST(\"resolved_at\" AS TIMESTAMP)) OVER ())) > 14400 THEN 1 ELSE 0 END",
     "op": "derive"
    },
    {
     "column": "ticket_ouvert",
     "expr": "CASE WHEN \"resolved_at\" IS NULL THEN 1 ELSE 0 END",
     "op": "derive"
    },
    {
     "column": "delai_resolution_h",
     "expr": "CASE WHEN \"resolved_at\" IS NOT NULL THEN date_diff('second', CAST(\"date_ouverture\" AS TIMESTAMP), CAST(\"resolved_at\" AS TIMESTAMP)) / 3600.0 END",
     "op": "derive"
    },
    {
     "column": "resolution_hors_delai",
     "expr": "CASE WHEN \"resolved_at\" IS NOT NULL THEN CASE WHEN date_diff('second', CAST(\"date_ouverture\" AS TIMESTAMP), CAST(\"resolved_at\" AS TIMESTAMP)) > 172800 THEN 1 ELSE 0 END WHEN date_diff('second', CAST(\"date_ouverture\" AS TIMESTAMP), GREATEST(MAX(CAST(\"date_ouverture\" AS TIMESTAMP)) OVER (), MAX(CAST(\"first_response_at\" AS TIMESTAMP)) OVER (), MAX(CAST(\"resolved_at\" AS TIMESTAMP)) OVER ())) > 172800 THEN 1 ELSE 0 END",
     "op": "derive"
    },
    {
     "column": "sla_respecte",
     "expr": "CASE WHEN reponse_hors_delai = 1 OR resolution_hors_delai = 1 THEN 0 ELSE 1 END",
     "op": "derive"
    }
   ]
  }
 ]
}
