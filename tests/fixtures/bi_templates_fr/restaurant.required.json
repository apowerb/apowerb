 "sources": [
  {
   "dataset_id": "11111111-2222-3333-4444-555555555555",
   "fields": [
    {
     "label": "Date",
     "name": "date",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "format": "compact",
     "label": "Chiffre d'affaires",
     "name": "ca",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Couverts",
     "name": "couverts",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Achats matières",
     "name": "achats_matieres",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Masse salariale",
     "name": "masse_salariale",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Semaine",
     "name": "periode_semaine",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    },
    {
     "label": "Jour de la semaine",
     "name": "jour_semaine",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    }
   ],
   "kind": "dataset",
   "label": "Exploitation du restaurant",
   "measures": [
    {
     "expr": "SUM(\"ca\")",
     "format": "compact",
     "label": "Chiffre d'affaires",
     "name": "ca",
     "unit": "€"
    },
    {
     "expr": "SUM(\"couverts\")",
     "format": "integer",
     "label": "Couverts",
     "name": "couverts",
     "unit": "couverts"
    },
    {
     "expr": "SUM(\"achats_matieres\")",
     "format": "compact",
     "label": "Achats matières",
     "name": "achats",
     "unit": "€"
    },
    {
     "expr": "SUM(\"masse_salariale\")",
     "format": "compact",
     "label": "Masse salariale",
     "name": "masse_salariale",
     "unit": "€"
    },
    {
     "description": "Achats matières ÷ chiffre d'affaires.",
     "expr": "SUM(\"achats_matieres\") / NULLIF(SUM(\"ca\"), 0)",
     "format": "percent",
     "label": "Coût matière",
     "name": "cout_matiere",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.35,
      "warn": 0.4
     }
    },
    {
     "description": "Masse salariale ÷ chiffre d'affaires.",
     "expr": "SUM(\"masse_salariale\") / NULLIF(SUM(\"ca\"), 0)",
     "format": "percent",
     "label": "Coût du personnel",
     "name": "cout_personnel"
    },
    {
     "description": "(Achats matières + masse salariale) ÷ chiffre d'affaires.",
     "expr": "(SUM(\"achats_matieres\") + SUM(\"masse_salariale\")) / NULLIF(SUM(\"ca\"), 0)",
     "format": "percent",
     "label": "Prime cost",
     "name": "prime_cost",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.65,
      "warn": 0.7
     }
    },
    {
     "description": "Chiffre d'affaires ÷ couverts.",
     "expr": "SUM(\"ca\") / NULLIF(SUM(\"couverts\"), 0)",
     "format": "decimal1",
     "label": "Ticket moyen",
     "name": "ticket_moyen",
     "unit": "€"
    },
    {
     "description": "Chiffre d'affaires ÷ nombre de jours distincts (les deux services d'un jour comptent pour un seul jour).",
     "expr": "SUM(\"ca\") / NULLIF(COUNT(DISTINCT CAST(\"date\" AS DATE)), 0)",
     "format": "compact",
     "label": "CA moyen par jour",
     "name": "ca_moyen_jour",
     "unit": "€"
    }
   ],
   "name": "exploitation",
   "source_options": {},
   "transforms": [
    {
     "column": "periode_semaine",
     "expr": "date_trunc('week', CAST(\"date\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "jour_semaine",
     "expr": "CASE isodow(CAST(\"date\" AS DATE)) WHEN 1 THEN '1-Lun' WHEN 2 THEN '2-Mar' WHEN 3 THEN '3-Mer' WHEN 4 THEN '4-Jeu' WHEN 5 THEN '5-Ven' WHEN 6 THEN '6-Sam' WHEN 7 THEN '7-Dim' END",
     "op": "derive",
     "provenance": "real"
    }
   ]
  }
 ]
}
