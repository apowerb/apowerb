    },
    {
     "label": "Article ou famille",
     "name": "article",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Montant",
     "name": "montant",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Quantité",
     "name": "quantity",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Date promise",
     "name": "promised_date",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Date de réception",
     "name": "received_date",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Mois",
     "name": "periode_mois",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    },
    {
     "format": "integer",
     "label": "Livré à l'heure",
     "name": "livraison_a_lheure",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "decimal1",
     "label": "Retard (jours)",
     "name": "retard_jours",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    }
   ],
   "kind": "dataset",
   "label": "Lignes d'achat",
   "measures": [
    {
     "expr": "SUM(\"montant\")",
     "format": "compact",
     "label": "Dépenses",
     "name": "depenses"
    },
    {
     "expr": "COUNT(*)",
     "format": "integer",
     "label": "Lignes d'achat",
     "name": "commandes",
     "unit": "lignes"
    },
    {
     "expr": "COUNT(DISTINCT \"fournisseur\")",
     "format": "integer",
     "label": "Fournisseurs",
     "name": "fournisseurs"
    },
    {
     "description": "Dépenses des cinq premiers fournisseurs sur les dépenses totales de la période filtrée. À lire sur l'ensemble de la sélection, pas par fournisseur.",
     "expr": "(SELECT SUM(s) FROM (SELECT SUM(\"montant\") AS s FROM frame GROUP BY \"fournisseur\" ORDER BY s DESC LIMIT 5)) / NULLIF(SUM(\"montant\"), 0)",
     "format": "percent",
     "label": "Part du top 5",
     "name": "part_top5",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.5,
      "warn": 0.7
     }
    },
    {
     "expr": "SUM(\"quantity\")",
     "format": "compact",
     "label": "Quantité",
     "name": "qte_totale"
    },
    {
     "description": "Montant divisé par la quantité, à lire par article.",
     "expr": "SUM(\"montant\") / NULLIF(SUM(\"quantity\"), 0)",
     "format": "decimal2",
     "label": "Prix moyen",
     "name": "prix_moyen"
    },
    {
     "description": "Lignes reçues à la date promise ou avant, sur les lignes reçues.",
     "expr": "AVG(livraison_a_lheure)",
     "format": "percent",
     "label": "Livré à l'heure",
     "name": "a_l_heure",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.95,
      "warn": 0.9
     }
    },
    {
     "description": "Jours de retard moyens des lignes reçues en retard.",
     "expr": "AVG(retard_jours)",
     "format": "decimal1",
     "label": "Retard moyen",
     "name": "retard_moyen",
     "unit": "jours"
    }
   ],
   "name": "achats",
   "source_options": {},
   "transforms": [
    {
     "column": "periode_mois",
     "expr": "date_trunc('month', CAST(\"date\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "livraison_a_lheure",
     "expr": "CASE WHEN \"received_date\" IS NULL OR \"promised_date\" IS NULL THEN NULL WHEN CAST(\"received_date\" AS DATE) <= CAST(\"promised_date\" AS DATE) THEN 1 ELSE 0 END",
     "op": "derive"
    },
    {
     "column": "retard_jours",
     "expr": "CASE WHEN \"received_date\" IS NOT NULL AND \"promised_date\" IS NOT NULL AND CAST(\"received_date\" AS DATE) > CAST(\"promised_date\" AS DATE) THEN date_diff('day', CAST(\"promised_date\" AS DATE), CAST(\"received_date\" AS DATE)) END",
     "op": "derive"
    }
   ]
  }
 ]
}
