    },
    {
     "format": "number",
     "label": "Temps planifié",
     "name": "planned_time",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "number",
     "label": "Temps de marche",
     "name": "run_time",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "number",
     "label": "Cadence idéale",
     "name": "ideal_rate",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Semaine",
     "name": "periode_semaine",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    }
   ],
   "kind": "dataset",
   "label": "Lots de production",
   "measures": [
    {
     "expr": "SUM(\"qte_produite\")",
     "format": "compact",
     "label": "Volume produit",
     "name": "volume_produit",
     "unit": "unités"
    },
    {
     "expr": "SUM(\"qte_rebut\")",
     "format": "compact",
     "label": "Volume rebuté",
     "name": "volume_rebut",
     "unit": "unités"
    },
    {
     "description": "Quantité rebutée ÷ quantité produite.",
     "expr": "SUM(\"qte_rebut\") / NULLIF(SUM(\"qte_produite\"), 0)",
     "format": "percent",
     "label": "Taux de rebut",
     "name": "taux_rebut",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.02,
      "warn": 0.05
     }
    },
    {
     "description": "Part de la production conforme dès le premier passage : 1 - rebut ÷ produit.",
     "expr": "1 - SUM(\"qte_rebut\") / NULLIF(SUM(\"qte_produite\"), 0)",
     "format": "percent",
     "label": "Bon du premier coup",
     "name": "bon_premier_coup",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.98,
      "warn": 0.95
     }
    },
    {
     "description": "Part cumulée du rebut expliquée par les causes les plus fréquentes.",
     "expr": "(SELECT SUM(r) FROM (SELECT SUM(\"qte_rebut\") AS r FROM frame WHERE \"defect\" IS NOT NULL GROUP BY \"defect\" ORDER BY r DESC LIMIT 1)) / NULLIF(SUM(\"qte_rebut\"), 0)",
     "format": "percent",
     "label": "Première cause (part du rebut)",
     "name": "part_top1"
    },
    {
     "description": "Part cumulée du rebut expliquée par les causes les plus fréquentes.",
     "expr": "(SELECT SUM(r) FROM (SELECT SUM(\"qte_rebut\") AS r FROM frame WHERE \"defect\" IS NOT NULL GROUP BY \"defect\" ORDER BY r DESC LIMIT 2)) / NULLIF(SUM(\"qte_rebut\"), 0)",
     "format": "percent",
     "label": "Deux premières causes (part du rebut)",
     "name": "part_top2"
    },
    {
     "description": "Part cumulée du rebut expliquée par les causes les plus fréquentes.",
     "expr": "(SELECT SUM(r) FROM (SELECT SUM(\"qte_rebut\") AS r FROM frame WHERE \"defect\" IS NOT NULL GROUP BY \"defect\" ORDER BY r DESC LIMIT 3)) / NULLIF(SUM(\"qte_rebut\"), 0)",
     "format": "percent",
     "label": "Trois premières causes (part du rebut)",
     "name": "part_top3"
    },
    {
     "description": "Temps de marche ÷ temps planifié.",
     "expr": "SUM(\"run_time\") / NULLIF(SUM(\"planned_time\"), 0)",
     "format": "percent",
     "label": "Disponibilité",
     "name": "disponibilite"
    },
    {
     "description": "Quantité produite ÷ (temps de marche × cadence idéale), plafonnée à 100 %.",
     "expr": "LEAST(1, SUM(\"qte_produite\") / NULLIF(SUM(\"run_time\" * \"ideal_rate\"), 0))",
     "format": "percent",
     "label": "Performance",
     "name": "performance"
    },
    {
     "description": "Quantité bonne ÷ quantité produite.",
     "expr": "(SUM(\"qte_produite\") - SUM(\"qte_rebut\")) / NULLIF(SUM(\"qte_produite\"), 0)",
     "format": "percent",
     "label": "Qualité",
     "name": "qualite"
    },
    {
     "description": "Taux de rendement synthétique : disponibilité × performance × qualité.",
     "expr": "(SUM(\"run_time\") / NULLIF(SUM(\"planned_time\"), 0)) * LEAST(1, SUM(\"qte_produite\") / NULLIF(SUM(\"run_time\" * \"ideal_rate\"), 0)) * ((SUM(\"qte_produite\") - SUM(\"qte_rebut\")) / NULLIF(SUM(\"qte_produite\"), 0))",
     "format": "percent",
     "label": "TRS",
     "name": "trs",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.85,
      "warn": 0.6
     }
    }
   ],
   "name": "production",
   "source_options": {},
   "transforms": [
    {
     "column": "periode_semaine",
     "expr": "date_trunc('week', CAST(\"date\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    }
   ]
  }
 ]
