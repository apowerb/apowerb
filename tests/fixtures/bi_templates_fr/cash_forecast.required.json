     "unit": "€"
    },
    {
     "expr": "SUM(solde_projete_central) FILTER (WHERE semaine_plan = 13)",
     "format": "compact",
     "label": "Solde à l'horizon (central)",
     "name": "solde_horizon_central",
     "unit": "€"
    },
    {
     "expr": "SUM(solde_projete_pessimiste) FILTER (WHERE semaine_plan = 13)",
     "format": "compact",
