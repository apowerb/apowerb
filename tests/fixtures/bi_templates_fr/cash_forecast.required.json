     "expr": "SUM(solde_projete_optimiste) FILTER (WHERE semaine_plan = 13)",
     "format": "compact",
     "label": "Solde à l'horizon (optimiste)",
     "name": "solde_horizon_optimiste",
     "unit": "€"
    },
    {
     "description": "Période du plan (1 = prochaine période) où un compte passe sous son seuil, scénario central ; vide si jamais.",
     "expr": "MIN(semaine_plan) FILTER (WHERE sous_seuil_central = 1)",
     "format": "integer",
     "label": "Première période sous le seuil",
     "name": "premiere_sous_seuil",
     "unit": "sem."
    },
    {
     "expr": "MIN(semaine_plan) FILTER (WHERE sous_seuil_pessimiste = 1)",
     "format": "integer",
     "label": "Première période sous le seuil (pessimiste)",
     "name": "premiere_sous_seuil_pessimiste",
     "unit": "sem."
    },
    {
     "expr": "MIN(semaine_plan) FILTER (WHERE sous_seuil_optimiste = 1)",
     "format": "integer",
     "label": "Première période sous le seuil (optimiste)",
     "name": "premiere_sous_seuil_optimiste",
     "unit": "sem."
    },
    {
     "description": "Solde actuel ÷ décaissements moyens par période de l'horizon.",
     "expr": "SUM(solde_projete_central) FILTER (WHERE semaine_plan = 0) / NULLIF(SUM(decaissements_projetes) FILTER (WHERE semaine_plan >= 1) / NULLIF(COUNT(DISTINCT semaine) FILTER (WHERE semaine_plan >= 1), 0), 0)",
     "format": "weeks",
     "label": "Semaines de trésorerie",
     "name": "semaines_tresorerie"
    },
    {
     "expr": "SUM(encaissements_projetes) FILTER (WHERE semaine_plan >= 1)",
     "format": "compact",
     "label": "Encaissements prévus sur l'horizon",
     "name": "encaissements_horizon",
     "unit": "€"
    },
    {
     "expr": "SUM(decaissements_projetes) FILTER (WHERE semaine_plan >= 1)",
     "format": "compact",
     "label": "Décaissements prévus sur l'horizon",
     "name": "decaissements_horizon",
     "unit": "€"
    },
    {
     "expr": "SUM(solde_projete_central)",
     "format": "compact",
     "label": "Central",
     "name": "solde_central_plan",
     "unit": "€"
    },
    {
     "expr": "SUM(solde_projete_pessimiste)",
     "format": "compact",
     "label": "Pessimiste",
     "name": "solde_pessimiste_plan",
