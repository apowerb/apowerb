     "type": "number"
    },
    {
     "format": "compact",
     "label": "Stock (réel puis projeté)",
     "name": "stock_projete",
     "provenance": "forecast",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Stock sans commande",
     "name": "stock_sans_commande",
     "provenance": "forecast",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Approvisionnements",
     "name": "reception",
