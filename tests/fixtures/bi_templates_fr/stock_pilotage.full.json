     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Seuil de sécurité",
     "name": "seuil_plan",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Délai fournisseur",
     "name": "delai_plan",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Risque",
     "name": "risque",
     "provenance": "forecast",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Semaine du plan",
     "name": "semaine_plan",
     "provenance": "real",
     "role": "dimension",
     "type": "number"
    }
   ],
   "kind": "source",
   "label": "Plan d'approvisionnement",
   "measures": [
    {
     "description": "Stock de la dernière semaine connue.",
     "expr": "SUM(stock) FILTER (WHERE semaine_plan = 0)",
     "format": "compact",
     "label": "Stock actuel",
     "name": "stock_actuel",
     "unit": "unités"
    },
    {
     "description": "Stock actuel ÷ prévision moyenne d'une semaine de l'horizon.",
     "expr": "SUM(stock) FILTER (WHERE semaine_plan = 0) / NULLIF(SUM(prevision_moteur) FILTER (WHERE semaine_plan >= 1) / NULLIF(COUNT(DISTINCT semaine) FILTER (WHERE semaine_plan >= 1), 0), 0)",
     "format": "weeks",
     "label": "Couverture",
     "name": "couverture_actuelle",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 4.0,
      "warn": 2.0
     }
    },
    {
     "expr": "SUM(prevision_moteur) FILTER (WHERE semaine_plan = 1)",
     "format": "compact",
     "label": "Prévision de la semaine",
     "name": "prevision_semaine",
     "unit": "unités"
    },
    {
     "expr": "SUM(prevision_moteur) FILTER (WHERE semaine_plan >= 1)",
     "format": "compact",
     "label": "Prévision sur l'horizon",
     "name": "prevision_horizon",
     "unit": "unités"
    },
    {
     "expr": "COALESCE(SUM(commande) FILTER (WHERE semaine_plan = 1), 0)",
     "format": "compact",
     "label": "À commander cette semaine",
     "name": "commande_semaine",
     "unit": "unités"
    },
    {
     "expr": "COUNT(DISTINCT famille) FILTER (WHERE semaine_plan = 1 AND commande > 0)",
     "format": "integer",
     "label": "Familles à commander cette semaine",
     "name": "familles_a_commander"
    },
    {
     "expr": "COALESCE(SUM(commande) FILTER (WHERE semaine_plan >= 1), 0)",
     "format": "compact",
     "label": "Commandes sur l'horizon",
     "name": "commandes_horizon",
     "unit": "unités"
    },
    {
     "description": "Semaine du plan où passer la prochaine commande (1 = cette semaine).",
     "expr": "MIN(semaine_plan) FILTER (WHERE semaine_plan >= 1 AND commande > 0)",
     "format": "integer",
     "label": "Prochaine commande",
     "name": "prochaine_commande",
     "unit": "semaine"
    },
    {
     "description": "Familles qui passent sous le seuil avant qu'une commande puisse arriver.",
     "expr": "COUNT(DISTINCT famille) FILTER (WHERE risque = 2)",
     "format": "integer",
     "label": "Familles à risque",
     "name": "familles_a_risque",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.0,
      "warn": 0.0
     }
    },
    {
     "description": "Semaines de l'horizon sous le seuil malgré les commandes.",
     "expr": "COUNT(*) FILTER (WHERE risque = 2)",
     "format": "integer",
     "label": "Semaines sous le seuil",
     "name": "semaines_sous_seuil",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.0,
      "warn": 0.0
     },
     "unit": "semaines"
    },
    {
     "description": "Semaines couvertes par le stock actuel sans commande (au plus 8).",
     "expr": "COUNT(*) FILTER (WHERE semaine_plan >= 1 AND stock_sans_commande > 0)",
     "format": "integer",
     "label": "Semaines avant rupture sans commande",
     "name": "semaines_avant_rupture",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 4.0,
      "warn": 2.0
     },
     "unit": "semaines"
    },
    {
     "expr": "(SELECT MIN(n) FROM (SELECT COUNT(*) FILTER (WHERE semaine_plan >= 1 AND stock_sans_commande > 0) AS n FROM frame GROUP BY famille))",
     "format": "integer",
     "label": "Semaines avant rupture sans commande",
     "name": "semaines_avant_rupture_min",
     "unit": "semaines"
    },
    {
     "expr": "SUM(stock_projete)",
     "format": "compact",
     "label": "Stock (réel puis projeté)",
     "name": "stock_plan",
     "unit": "unités"
    },
    {
     "expr": "SUM(prevision_moteur)",
     "format": "compact",
     "label": "Prévision",
     "name": "prevision_plan",
     "unit": "unités"
    },
    {
     "expr": "SUM(ventes)",
     "format": "compact",
     "label": "Ventes",
     "name": "ventes_plan",
     "unit": "unités"
    },
    {
     "expr": "SUM(reception)",
     "format": "compact",
     "label": "Approvisionnements",
