    }
   ],
   "name": "stocks",
   "source_options": {},
   "transforms": [
    {
     "aggregates": {
      "delai_fournisseur_sem": "MAX(delai_fournisseur_sem)",
      "seuil_securite": "SUM(seuil_securite)",
      "stock": "SUM(stock)",
      "ventes": "SUM(ventes)"
     },
     "group_by": [
      "semaine",
      "famille"
     ],
     "op": "aggregate"
    }
   ]
  },
  {
   "fields": [
    {
     "format": "compact",
     "label": "Prévision",
     "name": "prevision_moteur",
     "provenance": "forecast",
