 "sources": [
  {
   "dataset_id": "11111111-2222-3333-4444-555555555555",
   "fields": [
    {
     "label": "Date",
     "name": "date",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Consultant",
     "name": "consultant",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Heures passées",
     "name": "heures",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Heures disponibles",
     "name": "heures_disponibles",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Semaine",
     "name": "semaine",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    },
    {
     "format": "integer",
     "label": "Ligne facturable",
     "name": "est_facturable",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Heures facturables",
     "name": "heures_facturables_ligne",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Heures disponibles réparties",
     "name": "heures_dispo_ligne",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    }
   ],
   "kind": "dataset",
   "label": "Temps passés par consultant",
   "measures": [
    {
     "expr": "SUM(\"heures\")",
     "format": "compact",
     "label": "Heures passées",
     "name": "heures_total",
     "unit": "h"
    },
    {
     "expr": "SUM(heures_dispo_ligne)",
     "format": "compact",
     "label": "Heures disponibles",
     "name": "heures_dispo_total",
     "unit": "h"
    },
    {
     "expr": "SUM(heures_facturables_ligne)",
     "format": "compact",
     "label": "Heures facturables",
     "name": "heures_facturables",
     "unit": "h"
    },
    {
     "description": "Heures facturables ÷ 7 h par jour.",
     "expr": "SUM(heures_facturables_ligne) / 7.0",
     "format": "decimal1",
     "label": "Jours facturables",
     "name": "jours_facturables",
     "unit": "j"
    },
    {
     "description": "Heures passées ÷ heures disponibles.",
     "expr": "SUM(\"heures\") / NULLIF(SUM(heures_dispo_ligne), 0)",
     "format": "percent",
     "label": "Taux d'occupation",
     "name": "occupation",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.85,
      "warn": 0.75
     }
    },
    {
     "description": "Heures facturables ÷ heures passées.",
     "expr": "SUM(heures_facturables_ligne) / NULLIF(SUM(\"heures\"), 0)",
     "format": "percent",
     "label": "Taux facturable",
     "name": "taux_facturable",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.75,
      "warn": 0.65
     }
    }
   ],
   "name": "activite",
   "source_options": {},
   "transforms": [
    {
     "column": "semaine",
     "expr": "date_trunc('week', CAST(\"date\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "est_facturable",
     "expr": "CASE WHEN LOWER(TRIM(CAST(\"facturable\" AS VARCHAR))) IN ('1', '1.0', 'true', 't', 'oui', 'o', 'vrai', 'yes', 'y', 'x') THEN 1 ELSE 0 END",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "heures_facturables_ligne",
     "expr": "COALESCE(\"heures\", 0) * est_facturable",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "heures_dispo_ligne",
     "expr": "MAX(\"heures_disponibles\") OVER (PARTITION BY \"consultant\", CAST(\"date\" AS DATE)) / NULLIF(COUNT(*) OVER (PARTITION BY \"consultant\", CAST(\"date\" AS DATE)), 0)",
     "op": "derive",
     "provenance": "real"
    }
   ]
  }
 ]
