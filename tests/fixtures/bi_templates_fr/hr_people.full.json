 "sources": [
  {
   "dataset_id": "11111111-2222-3333-4444-555555555555",
   "fields": [
    {
     "label": "Mois",
     "name": "mois",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Salarié",
     "name": "salarie",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "label": "Service",
     "name": "service",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Heures théoriques",
     "name": "heures_theoriques",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Heures d'absence",
     "name": "heures_absence",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Masse salariale",
     "name": "masse_salariale",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Date d'entrée",
     "name": "entree",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Date de sortie",
     "name": "sortie",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Motif d'absence",
     "name": "motif_absence",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "label": "Mois",
     "name": "periode_mois",
     "provenance": "real",
     "role": "dimension",
     "type": "date"
    },
    {
     "label": "Salarié et mois",
     "name": "cle_salarie_mois",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "integer",
     "label": "Entrée ce mois",
     "name": "entree_ce_mois",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "integer",
     "label": "Sortie ce mois",
     "name": "sortie_ce_mois",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "label": "Motif d'absence",
     "name": "motif_affiche",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    }
   ],
   "kind": "dataset",
   "label": "Salariés par mois",
   "measures": [
    {
     "description": "Heures d'absence ÷ heures théoriques.",
     "expr": "SUM(\"heures_absence\") / NULLIF(SUM(\"heures_theoriques\"), 0)",
     "format": "percent",
     "label": "Taux d'absentéisme",
     "name": "absenteisme",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.05,
      "warn": 0.08
     }
    },
    {
     "description": "Salariés présents dans le mois ; effectif moyen sur une période.",
     "expr": "COUNT(DISTINCT cle_salarie_mois) * 1.0 / NULLIF(COUNT(DISTINCT periode_mois), 0)",
     "format": "decimal1",
     "label": "Effectif",
     "name": "effectif",
     "unit": "salariés"
    },
    {
     "description": "Somme du brut chargé de la période.",
     "expr": "SUM(\"masse_salariale\")",
     "format": "compact",
     "label": "Masse salariale",
     "name": "masse_totale",
     "unit": "€"
    },
    {
     "description": "Masse salariale ÷ nombre de salariés-mois.",
     "expr": "SUM(\"masse_salariale\") / NULLIF(COUNT(DISTINCT cle_salarie_mois), 0)",
     "format": "compact",
     "label": "Coût moyen par salarié",
     "name": "cout_moyen",
     "unit": "€ / mois"
    },
    {
     "expr": "SUM(\"heures_absence\")",
     "format": "compact",
     "label": "Heures d'absence",
     "name": "heures_absence_total",
     "unit": "h"
    },
    {
     "expr": "COUNT(DISTINCT CASE WHEN entree_ce_mois = 1 THEN cle_salarie_mois END)",
     "format": "integer",
     "label": "Entrées",
     "name": "entrees",
     "unit": "salariés"
    },
    {
     "expr": "COUNT(DISTINCT CASE WHEN sortie_ce_mois = 1 THEN cle_salarie_mois END)",
     "format": "integer",
     "label": "Sorties",
     "name": "sorties",
     "unit": "salariés"
    },
    {
     "description": "Départs de la période ÷ effectif moyen de la période.",
     "expr": "COUNT(DISTINCT CASE WHEN sortie_ce_mois = 1 THEN cle_salarie_mois END) * 1.0 / NULLIF(COUNT(DISTINCT cle_salarie_mois) * 1.0 / NULLIF(COUNT(DISTINCT periode_mois), 0), 0)",
     "format": "percent",
     "label": "Turnover",
     "name": "turnover",
     "thresholds": {
      "direction": "lower_is_better",
      "good": 0.1,
      "warn": 0.2
     }
    }
   ],
   "name": "rh",
   "source_options": {},
   "transforms": [
    {
     "column": "periode_mois",
     "expr": "date_trunc('month', CAST(\"mois\" AS TIMESTAMP))",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "cle_salarie_mois",
     "expr": "CAST(\"salarie\" AS VARCHAR) || '|' || CAST(periode_mois AS VARCHAR)",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "entree_ce_mois",
     "expr": "CASE WHEN \"entree\" IS NOT NULL AND date_trunc('month', CAST(\"entree\" AS TIMESTAMP)) = periode_mois THEN 1 ELSE 0 END",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "sortie_ce_mois",
     "expr": "CASE WHEN \"sortie\" IS NOT NULL AND date_trunc('month', CAST(\"sortie\" AS TIMESTAMP)) = periode_mois THEN 1 ELSE 0 END",
     "op": "derive",
     "provenance": "real"
    },
    {
     "column": "motif_affiche",
     "expr": "CASE WHEN COALESCE(\"heures_absence\", 0) > 0 THEN COALESCE(NULLIF(TRIM(CAST(\"motif_absence\" AS VARCHAR)), ''), 'Non précisé') END",
     "op": "derive",
     "provenance": "real"
    }
   ]
  }
 ]
}
