 ],
 "sources": [
  {
   "dataset_id": "11111111-2222-3333-4444-555555555555",
   "fields": [
    {
     "label": "Mois",
     "name": "mois",
     "provenance": "real",
     "role": "date",
     "type": "date"
    },
    {
     "label": "Famille",
     "name": "famille",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "label": "Customer",
     "name": "customer",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "label": "Region",
     "name": "region",
     "provenance": "real",
     "role": "dimension",
     "type": "string"
    },
    {
     "format": "compact",
     "label": "Chiffre d'affaires",
     "name": "ca",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "CA même mois N-1",
     "name": "ca_n1",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    },
    {
     "format": "compact",
     "label": "Quantité",
     "name": "quantite",
     "provenance": "real",
     "role": "measure",
     "type": "number"
    }
   ],
   "kind": "dataset",
   "label": "Ventes par mois",
   "measures": [
    {
     "expr": "SUM(ca)",
     "format": "compact",
     "label": "Chiffre d'affaires",
     "name": "ca_total"
    },
    {
     "description": "Chiffre d'affaires des mêmes mois un an plus tôt.",
     "expr": "SUM(ca_n1)",
     "format": "compact",
     "label": "CA même période N-1",
     "name": "ca_n1_total"
    },
    {
     "description": "Chiffre d'affaires des mois qui ont un équivalent un an plus tôt.",
     "expr": "SUM(ca) FILTER (WHERE n1_dispo = 1)",
     "format": "compact",
     "label": "CA des mois comparables",
     "name": "ca_comparable"
    },
    {
     "description": "CA des mois comparables ÷ CA des mêmes mois un an plus tôt, moins 1.",
     "expr": "SUM(ca) FILTER (WHERE n1_dispo = 1) / NULLIF(SUM(ca_n1), 0) - 1",
     "format": "percent",
     "label": "Évolution vs N-1",
     "name": "evolution_n1",
     "thresholds": {
      "direction": "higher_is_better",
      "good": 0.0,
      "warn": -0.05
     }
    },
    {
     "expr": "NULLIF(SUM(ca_n1) FILTER (WHERE n1_dispo = 1), 0)",
     "format": "compact",
     "label": "Même mois N-1",
     "name": "ca_n1_mensuel"
    },
    {
     "description": "Part de la ligne dans le CA de la période, toutes familles confondues.",
     "expr": "SUM(ca) / NULLIF((SELECT SUM(ca) FROM frame), 0)",
     "format": "percent",
     "label": "Part du CA",
     "name": "part_ca"
    },
    {
     "expr": "SUM(quantite)",
     "format": "compact",
     "label": "Quantité",
     "name": "quantite_totale"
    },
    {
     "description": "Chiffre d'affaires ÷ quantité vendue.",
     "expr": "SUM(ca) / NULLIF(SUM(quantite), 0)",
     "format": "decimal2",
     "label": "Prix moyen",
     "name": "prix_moyen"
    },
    {
     "description": "Clients avec au moins un achat sur la période.",
     "expr": "COUNT(DISTINCT \"customer\") FILTER (WHERE ca <> 0)",
     "format": "integer",
     "label": "Clients actifs",
     "name": "nb_clients"
    }
   ],
   "name": "ventes",
   "source_options": {},
   "transforms": [
    {
     "op": "sql",
     "query": "WITH base AS (SELECT date_trunc('month', CAST(\"date\" AS DATE)) AS mois, \"famille\", \"customer\", \"region\", SUM(\"montant\") AS ca, SUM(\"quantity\") AS quantite FROM input WHERE \"date\" IS NOT NULL GROUP BY 1, 2, 3, 4), edge AS (SELECT MIN(mois) AS first_m, MAX(mois) AS last_m FROM base) SELECT mois, \"famille\", \"customer\", \"region\", SUM(ca) AS ca, SUM(quantite) AS quantite, SUM(ca_n1) AS ca_n1, CASE WHEN mois - INTERVAL 12 MONTH >= (SELECT first_m FROM edge) THEN 1 ELSE 0 END AS n1_dispo FROM (SELECT mois, \"famille\", \"customer\", \"region\", ca, quantite, 0.0 AS ca_n1 FROM base UNION ALL SELECT CAST(mois + INTERVAL 12 MONTH AS DATE) AS mois, \"famille\", \"customer\", \"region\", 0.0 AS ca, 0.0 AS quantite, ca AS ca_n1 FROM base WHERE mois + INTERVAL 12 MONTH <= (SELECT last_m FROM edge)) GROUP BY ALL"
    }
   ]
  }
 ]
}
